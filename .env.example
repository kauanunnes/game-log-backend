# Em produção, defina estas variáveis na plataforma de hospedagem.
# Em desenvolvimento, o perfil local é o padrão e o Spring sobe o PostgreSQL do compose.yaml
# sozinho; basta um .env na raiz com as variáveis do IGDB.

SPRING_PROFILES_ACTIVE=prod

# No Neon: jdbc:postgresql://<host>/<banco>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gamelog
SPRING_DATASOURCE_USERNAME=gamelog
SPRING_DATASOURCE_PASSWORD=

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Chave RSA que assina os access tokens (obrigatória em produção). Para gerar:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
# Cole o conteúdo do jwt.pem; numa linha só, troque as quebras por \n.
JWT_PRIVATE_KEY=

# App da Twitch (dev.twitch.tv/console/apps). Sem elas, a busca usa só o que já está no banco.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SMTP dos e-mails da conta (confirmação e nova senha). Sem host, os e-mails vão para o log.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=Game Log <nao-responda@seu-dominio>

# Endereço do front, usado nos links dos e-mails
APP_URL=http://localhost:5173
