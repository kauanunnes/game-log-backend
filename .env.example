# Em produção, defina estas variáveis na plataforma de hospedagem.
# Em desenvolvimento, o perfil local é o padrão e o Spring sobe o PostgreSQL do compose.yaml
# sozinho; basta um .env na raiz com as variáveis do IGDB.

SPRING_PROFILES_ACTIVE=prod

# No Neon: jdbc:postgresql://<host>/<banco>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gamelog
SPRING_DATASOURCE_USERNAME=gamelog
SPRING_DATASOURCE_PASSWORD=

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# App da Twitch (dev.twitch.tv/console/apps). Sem elas, a busca usa só o que já está no banco.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
